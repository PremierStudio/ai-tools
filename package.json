{
  "name": "@itz4blitz/ai-tools-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/smoke-package.mjs",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --tsconfig tsconfig.base.json packages/",
    "lint:fix": "oxlint --fix --tsconfig tsconfig.base.json packages/",
    "fmt": "oxfmt packages/",
    "fmt:check": "oxfmt --check packages/",
    "audit": "npm audit --omit=dev --audit-level high",
    "check": "npm run audit && npm run lint && npm run fmt:check && npm run typecheck && npm run test:coverage && npm run test:smoke",
    "release:preflight": "npm run check",
    "release:publish:dry": "npm publish --workspace @itz4blitz/ai-tools --access public --dry-run",
    "release:publish": "npm run check && npm publish --workspace @itz4blitz/ai-tools --access public",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.68.0",
    "semantic-release": "^25.0.3",
    "tsup": "^8.4.0",
    "turbo": "^2.9.16",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.0",
  "version": "1.1.10"
}
