{
  "name": "@itz4blitz/ai-tools-tui",
  "version": "1.2.3",
  "private": true,
  "description": "Interactive terminal dashboard for AI coding tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itz4blitz/ai-tools.git"
  },
  "bin": {
    "ai-tools-tui": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli/bin.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"const { rmSync } = require('node:fs'); rmSync('dist', { recursive: true, force: true });\"",
    "dev:build": "tsup --watch",
    "dev:run": "node dist/cli/bin.js --dev"
  },
  "dependencies": {
    "@itz4blitz/ai-tools-sessions": "1.2.3",
    "@rezi-ui/core": "^0.1.0-alpha.26",
    "@rezi-ui/native": "^0.1.0-alpha.26",
    "@rezi-ui/node": "^0.1.0-alpha.26",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
