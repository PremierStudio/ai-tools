{
  "name": "@itz4blitz/ai-tools-sessions",
  "version": "1.1.9",
  "private": true,
  "description": "Cross-tool session reading and context handoff for AI coding tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itz4blitz/ai-tools.git"
  },
  "bin": {
    "ai-tools-sessions": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/all": {
      "types": "./dist/adapters/all.d.ts",
      "import": "./dist/adapters/all.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"const { rmSync } = require('node:fs'); rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
