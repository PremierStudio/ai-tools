{
  "name": "@itz4blitz/ai-tools",
  "version": "1.1.9",
  "description": "Unified CLI for all ai-tools engines (hooks, mcp, skills, agents, rules)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itz4blitz/ai-tools.git"
  },
  "bin": {
    "ai-tools": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "import": "./dist/skills.js"
    },
    "./agents": {
      "types": "./dist/agents.d.ts",
      "import": "./dist/agents.js"
    },
    "./rules": {
      "types": "./dist/rules.d.ts",
      "import": "./dist/rules.js"
    },
    "./sessions": {
      "types": "./dist/sessions.d.ts",
      "import": "./dist/sessions.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "node ../../scripts/vendor-cli-bundle.js",
    "postpack": "node ../../scripts/clean-cli-bundle.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "node -e \"const { rmSync } = require('node:fs'); rmSync('dist', { recursive: true, force: true });\""
  },
  "dependencies": {
    "@itz4blitz/ai-tools-agents": "1.1.8",
    "@itz4blitz/ai-tools-hooks": "1.1.8",
    "@itz4blitz/ai-tools-mcp": "1.1.8",
    "@itz4blitz/ai-tools-rules": "1.1.8",
    "@itz4blitz/ai-tools-sessions": "1.1.8",
    "@itz4blitz/ai-tools-skills": "1.1.8",
    "@itz4blitz/ai-tools-tui": "1.1.8"
  },
  "bundledDependencies": [
    "@itz4blitz/ai-tools-agents",
    "@itz4blitz/ai-tools-hooks",
    "@itz4blitz/ai-tools-mcp",
    "@itz4blitz/ai-tools-rules",
    "@itz4blitz/ai-tools-sessions",
    "@itz4blitz/ai-tools-skills",
    "@itz4blitz/ai-tools-tui"
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
